# Discord-only production: leave TELEGRAM_BOT_TOKEN empty and run bot_discord.py
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3-8B
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
PROMPT_ID=v3_zh_general

# Discord user ID for unban appeals (shown in ban DMs)
APPEAL_DISCORD_USER_ID=

# HITL example sync back to GitHub
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=groq-approach

# Telegram webhook mode only (ignored by Discord bot)
WEBHOOK_URL=https://susmessagebot.commonertech.dev
USE_POLLING=false

# Runtime paths / ports (Compose sets DATA_DIR=/app/data)
# DATA_DIR=/app/data
# HEALTH_PORT=8001
# METRICS_PORT=8000
